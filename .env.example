SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-public-key
ls -la .env.example
cat << 'EOF' > .env.example
# Supabase Configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-public-key
# Server-only: Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
